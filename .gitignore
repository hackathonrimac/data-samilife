# ==========================
# SISTEMA OPERATIVO (OS)
# ==========================
# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================
# PYTHON & ENTORNO
# ==========================
__pycache__/
*.py[cod]
node_modules/

# Entornos virtuales (Nombres comunes)
venv/
env/
.venv/

# ==========================
# SEGURIDAD
# ==========================
.env

# ==========================
# DATOS (DATA SCIENCE)
# ==========================
# Ignora carpetas de descarga y salida
# data/
downloads/
output/

# Ignora archivos de datos específicos (Excel de salud, etc.)
# *.csv
*.xlsx
*.xls
*.xml

# ==========================
# WEB SCRAPING & DRIVERS
# ==========================
# Logs (excepto los de backend que están en src/backend/logs/)
*.log
logs/
!src/backend/logs/.gitkeep

# Drivers de Selenium (Mac/Linux no usan extensión, Windows usa .exe)
chromedriver
geckodriver
msedgedriver
# Específico Windows
*.exe
chromedriver.exe
geckodriver.exe
msedgedriver.exe

# ==========================
# IDEs (Editores)
# ==========================
.vscode/
.idea/
.kiro

# ==========================
# DOCKER
# ==========================
# No ignorar Dockerfiles
!Dockerfile
!Dockerfile.*
!docker-compose*.yml
!.dockerignore

# Ignorar archivos .env de Docker (excepto ejemplos)
src/backend/.env
!src/backend/.env.docker.example

.hypothesis/
/src/data
